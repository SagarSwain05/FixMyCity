# ---- Required ----
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=fixmycity
# Long random string: `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# ---- URLs ----
PORT=4000
# Public URL of this API (used for locally stored uploads)
PUBLIC_API_URL=http://localhost:4000
# Citizen app URL (used in email links)
CLIENT_URL=http://localhost:5173
# Comma-separated allowed browser origins; supports one wildcard label, e.g. https://fixmycity-*.vercel.app
# Leave empty in local dev to allow all.
CORS_ORIGINS=

# ---- Bootstrap admin (created on first start if no admin exists) ----
ADMIN_PHONE=+919000000000
ADMIN_EMAIL=admin@fixmycity.in
ADMIN_PASSWORD=Admin@1234

# ---- Media storage (recommended in production; falls back to local disk) ----
# Cloudinary dashboard > API Environment variable
CLOUDINARY_URL=
UPLOAD_DIR=uploads

# ---- Email notifications via Brevo (optional) ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=FixMyCity

# ---- Tuning (optional) ----
DUPLICATE_RADIUS_METERS=50
VERIFY_RADIUS_METERS=2000
COMMUNITY_VERIFY_THRESHOLD=3
