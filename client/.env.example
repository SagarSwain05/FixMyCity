# URL of the FixMyCity API (no trailing slash)
VITE_API_URL=http://localhost:4000
# Map fallback centre "lat,lng" when GPS is unavailable (default: Bhubaneswar)
VITE_DEFAULT_CENTER=20.2961,85.8245
# URL of the municipal command center (linked from the landing page)
VITE_ADMIN_URL=http://localhost:5174
